{
  "trigger": "/pisa",
  "dmWithoutTrigger": true,
  "whitelist": {
    "users": ["<telegram user id>"],
    "repos": ["pisa"]
  },
  "repos": [
    {
      "alias": "pisa",
      "path": "/absolute/path/to/repo",
      "baseBranch": "main"
    }
  ],
  "worker": {
    "command": "omp",
    "timeoutSec": 3600,
    "extraArgs": [],
    "concurrency": 2
  },
  "delivery": {
    "push": false,
    "pr": false,
    "commitName": "pisa",
    "commitEmail": "pisa@localhost"
  },
  "channels": {
    "cli": false,
    "telegram": {
      "enabled": true,
      "tokenEnv": "PISA_TELEGRAM_TOKEN",
      "proxy": ""
    }
  },
  "webhook": {
    "enabled": false,
    "port": 8799,
    "tokenEnv": "PISA_WEBHOOK_TOKEN",
    "chatId": "<telegram chat id>",
    "userId": "<telegram user id>"
  },
  "stateDir": ".pisa"
}
