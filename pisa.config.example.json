{
  "trigger": "/pisa",
  "dmWithoutTrigger": true,
  "whitelist": {
    "users": ["<telegram user id>"],
    "repos": ["pisa"]
  },
  "repos": [
    {
      "alias": "pisa",
      "path": "/absolute/path/to/repo",
      "baseBranch": "main"
    }
  ],
  "worker": {
    "adapter": "omp",
    "command": "omp",
    "timeoutSec": 3600,
    "verifyTimeoutSec": 600,
    "extraArgs": [],
    "concurrency": 2
  },
  "delivery": {
    "push": false,
    "pr": false,
    "commitName": "pisa",
    "commitEmail": "pisa@localhost"
  },
  "channels": {
    "cli": false,
    "telegram": {
      "enabled": true,
      "tokenEnv": "PISA_TELEGRAM_TOKEN",
      "proxy": ""
    }
  },
  "webhook": {
    "enabled": false,
    "port": 8799,
    "tokenEnv": "PISA_WEBHOOK_TOKEN",
    "chatId": "<telegram chat id>",
    "userId": "<telegram user id>"
  },
  "github": {
    "enabled": false,
    "intervalSec": 120,
    "tokenEnv": "GH_TOKEN",
    "repos": [
      {
        "repo": "owner/pisa",
        "chatId": "<telegram chat id>",
        "userId": "<telegram user id>"
      },
      {
        "repo": "owner/site",
        "chatId": "<telegram chat id>",
        "userId": "<telegram user id>"
      }
    ]
  },
  "scheduler": {
    "chatId": "<telegram chat id>",
    "userId": "<telegram user id>"
  },
  "schedules": [
    {
      "id": "morning",
      "cron": "0 9 * * 1-5",
      "prompt": "检查昨天以来的 CI 失败并修复",
      "repo": "pisa",
      "enabled": false
    }
  ],
  "proactive": {
    "keywords": {
      "enabled": false,
      "words": ["挂了", "报错", "失败"],
      "cooldownSec": 600,
      "chatId": "<group chat id>",
      "userId": "<telegram user id>",
      "prompt": "群里有人报障且没人接：先定位原因，能修就修，不能修给出下一步。"
    },
    "probe": {
      "enabled": false,
      "command": "gh run list --limit 1 --json conclusion -q '.[0].conclusion' | grep -q success",
      "intervalSec": 300,
      "cooldownSec": 1800,
      "chatId": "<telegram chat id>",
      "userId": "<telegram user id>",
      "repo": "pisa",
      "prompt": "自动探针失败，定位原因并修复。"
    }
  },
  "stateDir": ".pisa"
}
